{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/cosmokit": ["../../vendor/cosmokit/lib/types/index.d.ts"],
      "@standard-schema/spec": ["../../vendor/standard-schema/spec/dist/index.d.ts"]
    }
  },
  "include": [
    "src"
  ]
}
