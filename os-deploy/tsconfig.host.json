{
  // typert-generator 工作区聚合（Host 面）。参照 deepseek-harness 的
  // tsconfig.base.json + tsconfig.host.json：packages/ 下每个包经
  // projectReferences 注册，@deepseek-ai/dsh-typert-protocol 通过 paths
  // 映射到工作区源码（isTypeMetaSymbol 要求 Remote 装饰器由工作区包声明）。
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["./vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/cosmokit": ["./vendor/cosmokit/lib/types/index.d.ts"],
      "@standard-schema/spec": ["./vendor/standard-schema/spec/dist/index.d.ts"],
      "@deepseek-ai/dsh-typert-protocol": ["./packages/dsh-typert-protocol/src/index.ts"],
      "@deepseek-ai/dsh-typert-protocol/types": ["./packages/dsh-typert-protocol/src/types.ts"]
    }
  },
  "files": [
    "packages/dsh-typert-protocol/src/index.ts"
  ],
  "references": [
    { "path": "packages/dsh-os-deploy" },
    { "path": "packages/dsh-typert-protocol" }
  ]
}
